# =============================================================================
# Environment Configuration
# =============================================================================
#
# SETUP:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values
# 3. Never commit .env to version control
#
# For local development, only LOG_LEVEL and DATA_DIR are required.
# Cloud credentials are optional until deployment.
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Base directory for data files (relative to project root)
DATA_DIR=./data

# Environment identifier: development, staging, production
ENVIRONMENT=development

# =============================================================================
# Snowflake Data Warehouse
# =============================================================================

# Account identifier from Snowflake console
# Format: <account_locator>.<region>.<cloud> or <orgname>-<account_name>
SNOWFLAKE_ACCOUNT=

# User credentials
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Warehouse and database configuration
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RETAIL_ONBOARDING
SNOWFLAKE_SCHEMA=RAW

# Role for access control (optional, uses user's default if not set)
SNOWFLAKE_ROLE=

# =============================================================================
# AWS S3 Storage
# =============================================================================

# AWS credentials (or use IAM roles/AWS CLI credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# S3 bucket for pipeline data
S3_BUCKET=
S3_PREFIX=retail-pipeline

# =============================================================================
# OCR Configuration
# =============================================================================

# Path to Tesseract binary (usually auto-detected)
# Uncomment and set if Tesseract is not in PATH
# TESSERACT_CMD=/usr/local/bin/tesseract

# OCR language pack (eng=English, use + for multiple: eng+spa)
TESSERACT_LANG=eng

# =============================================================================
# Data Quality Settings
# =============================================================================

# Great Expectations failure threshold (0.0 to 1.0)
# 0.95 = allow up to 5% of rows to fail expectations
GE_FAILURE_THRESHOLD=0.95

# Path to Great Expectations project directory
GE_ROOT_DIR=./great_expectations
